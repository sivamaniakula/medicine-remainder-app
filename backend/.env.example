# MongoDB Atlas connection string
MONGO_URI=your_mongodb_atlas_connection_string

# Secret used to sign JWTs - use a long random string, never reuse across projects
JWT_SECRET=your_random_jwt_secret

PORT=5000

# --- Bundle B: reminder channels ---

# Firebase (push notifications)
# Path to the service account JSON file you downloaded from
# Firebase Console -> Project Settings -> Service Accounts.
# Example: ./firebase-service-account.json (place the file in the backend folder,
# and make sure it's listed in .gitignore - never commit it)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Twilio (WhatsApp + Voice)
# Found in your Twilio Console dashboard
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Your Twilio phone number, used for outbound voice calls. Format: +1234567890
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# WhatsApp sandbox number from Twilio Console -> Messaging -> Try it out -> WhatsApp.
# Must be prefixed with "whatsapp:", e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Publicly reachable URL for this backend, required so Twilio can call back
# into /api/voice/* webhooks. During development, run `ngrok http 5000` and
# paste the https URL it gives you here (update it each time ngrok restarts,
# since free ngrok URLs change on every run).
BACKEND_PUBLIC_URL=https://your-ngrok-subdomain.ngrok-free.app
