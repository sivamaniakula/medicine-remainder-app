# Local dev default is http://localhost:5000/api (see src/api/client.js).
# For a custom backend URL locally, uncomment and set this:
# VITE_API_BASE_URL=http://localhost:5000/api

# In production on Vercel, set VITE_API_BASE_URL in the Vercel dashboard
# (Project Settings -> Environment Variables) to your deployed backend, e.g.
# VITE_API_BASE_URL=https://your-backend.onrender.com/api
